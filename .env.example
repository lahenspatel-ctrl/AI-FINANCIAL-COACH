# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Get a free key at https://openrouter.ai (supports many free models)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Get a free key at https://tavily.com (web search for the AI coach)
TAVILY_API_KEY=tvly-your-tavily-key-here

# ── Optional overrides ────────────────────────────────────────────────────────
# Override the LangGraph model per agent role.
# JSON object: { "role_name": ["model/id:tag", ...], ... }
# MODEL_OVERRIDES_JSON={}

# App settings
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400

# Rate limiting (requests per minute per model on OpenRouter)
RATE_LIMIT_RPM=20

# Tavily search results per query (keep low to save quota)
TAVILY_MAX_RESULTS=3
